---
import '@fontsource-variable/manrope';
import '@fontsource/poppins/300.css';
import '@fontsource/poppins/400.css';
import '@fontsource/poppins/500.css';
import '@fontsource/poppins/600.css';
import '../styles/global.css';
import Header from '../components/astro/Header.astro';
import Footer from '../components/astro/Footer.astro';
import CookieBanner from '../components/react/CookieBanner';
import { site } from '../data/site';

interface Props { title?: string; description?: string; }
const { title = `${site.name} | Marketing for aesthetic & medical practices`, description = site.description } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a0a0b" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <title>{title}</title>
    <noscript><style>[data-reveal]{opacity:1!important;transform:none!important}.img-round[data-reveal] img{scale:1!important;clip-path:none!important}#page-loader{display:none!important}html{overflow:auto!important}</style></noscript>
    <script is:inline>try{if(sessionStorage.getItem('lm-loaded'))document.documentElement.classList.add('no-loader')}catch(e){}</script>
  </head>
  <body>
    <div id="page-loader" aria-hidden="true">
      <div class="pl-inner"><div class="pl-logo"><img src="/images/lm-logo.png" alt="" width="900" height="572" /><span class="pl-shine"></span></div><div class="pl-bar"><span></span></div></div>
    </div>
    <div id="scroll-progress" aria-hidden="true"></div>
    <Header />
    <main><slot /></main>
    <Footer />
    <CookieBanner client:load />
    <script>
      const root = document.documentElement;
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Loader: shown once per visit, lifts when the page is ready (min 2.5s, max 4s)
      const done = () => { root.classList.add('is-loaded'); try { sessionStorage.setItem('lm-loaded', '1'); } catch (e) {} setTimeout(() => document.getElementById('page-loader')?.remove(), 1200); };
      if (root.classList.contains('no-loader') || reduce) { root.classList.add('is-loaded'); }
      else {
        const start = performance.now(); let fired = false;
        const go = () => { if (fired) return; fired = true; setTimeout(done, Math.max(0, 2500 - (performance.now() - start))); };
        if (document.readyState === 'complete') go(); else addEventListener('load', go);
        setTimeout(go, 4000);
      }

      // Stagger: children of [data-stagger] reveal one after another
      document.querySelectorAll('[data-stagger]').forEach((parent) => {
        [...parent.children].forEach((c, i) => { c.setAttribute('data-reveal', ''); (c as HTMLElement).style.setProperty('--d', `${i * 0.11}s`); });
      });

      // Reveal-on-scroll for any element with [data-reveal]
      const els = document.querySelectorAll('[data-reveal]');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries) => {
          entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } });
        }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });
        els.forEach((el) => io.observe(el));
      } else { els.forEach((el) => el.classList.add('is-in')); }

      // Scroll progress bar + gentle parallax
      const bar = document.getElementById('scroll-progress');
      const par = [...document.querySelectorAll<HTMLElement>('[data-parallax]')];
      let tick = false;
      const update = () => {
        tick = false;
        const max = document.documentElement.scrollHeight - innerHeight;
        bar?.style.setProperty('--p', String(max > 0 ? Math.min(1, scrollY / max) : 0));
        if (!reduce) par.forEach((el) => { const r = el.parentElement!.getBoundingClientRect(); if (r.bottom > 0 && r.top < innerHeight) el.style.translate = `0 ${(-r.top * Number(el.dataset.parallax)).toFixed(1)}px`; });
      };
      addEventListener('scroll', () => { if (!tick) { tick = true; requestAnimationFrame(update); } }, { passive: true });
      update();
    </script>
  </body>
</html>

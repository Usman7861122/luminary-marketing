---
import PageLayout from '../layouts/PageLayout.astro';
import { serviceGroups, serviceShort } from '../data/services';
---
<PageLayout
  title="Services | Luminary Marketing"
  heading="Services built around your practice"
  eyebrow="Our services"
  lede="We focus on the whole process, from brand awareness and patient acquisition to staff performance, lead management, consultation bookings and conversions."
  description="Eight service areas for medical aesthetics and wellness practices: strategy, sales, content, paid ads, devices, brand, events and reporting."
  image="/images/stock/clinic-reception.webp"
  imageAlt=""
  position="50% 45%"
>
  <section class="container-lux py-20 md:py-28" aria-labelledby="svc-grid">
    <div class="mb-12 max-w-3xl" data-reveal>
      <p class="eyebrow">Choose an area</p>
      <h2 id="svc-grid" class="h-display mt-6 text-4xl md:text-5xl">More than marketing. <span class="text-gold-shine font-medium">We understand the business behind it.</span></h2>
    </div>
    <ul class="grid grid-cols-2 gap-4 lg:grid-cols-4 lg:gap-5">
      {serviceGroups.map((o, k) => (
        <li data-reveal style={`--d:${(k % 4) * 0.08}s`}>
          <a href={o.href} class="group relative block aspect-[4/5] overflow-hidden rounded-[14px] bg-obsidian text-ivory">
            <img src={o.image} alt="" loading="lazy" style={`object-position:${o.pos}`} class="absolute inset-0 h-full w-full object-cover transition-transform duration-[1100ms] ease-out group-hover:scale-[1.08]" />
            <div class="absolute inset-0 bg-gradient-to-t from-obsidian/95 via-obsidian/40 to-obsidian/10"></div>
            <span aria-hidden="true" class="pointer-events-none absolute inset-3 rounded-[10px] border border-ivory/0 transition-colors duration-500 group-hover:border-champagne/70"></span>
            <div class="absolute inset-x-0 bottom-0 p-5 md:p-6">
              <span class="font-display text-xs tracking-[0.3em] text-champagne">{o.n}</span>
              <h3 class="mt-2 font-display text-lg font-light leading-snug md:text-[1.25rem]">{serviceShort[k]}</h3>
              <span class="mt-3 inline-flex items-center gap-2 text-[0.62rem] font-medium uppercase tracking-[0.22em] text-champagne-soft opacity-0 transition-opacity duration-500 group-hover:opacity-100">View details
                <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              </span>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </section>

  {serviceGroups.map((g) => (
    <section id={g.slug} class="container-lux scroll-mt-28 py-14 md:py-20" aria-labelledby={`${g.slug}-t`}>
      <div class="grid gap-10 border-t border-ivory/10 pt-12 lg:grid-cols-12 lg:gap-16" data-reveal>
        <div class="lg:col-span-4">
          <p class="font-display text-sm tracking-[0.3em] text-champagne">{g.n}</p>
          <h2 id={`${g.slug}-t`} class="h-display mt-4 text-3xl md:text-4xl">{g.title}</h2>
          <p class="mt-5 text-[0.95rem] leading-7 text-ivory/65">{g.text}</p>
          <a href={g.href} class="link-lux mt-6 inline-block">View details</a>
        </div>
        <ul class="divide-y divide-ivory/10 border-y border-ivory/10 lg:col-span-8">
          {g.items.map(([name, text]) => (
            <li class="row-hover grid gap-2 py-5 md:grid-cols-[17rem_1fr] md:gap-10">
              <h3 class="font-display text-lg font-normal text-ivory">{name}</h3>
              <p class="text-[0.92rem] leading-7 text-ivory/65">{text}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  ))}

  <section class="container-lux py-24 text-center">
    <h2 class="h-display mx-auto max-w-3xl text-3xl md:text-5xl">Ready to turn attention into <span class="text-gold-shine font-medium">booked consultations?</span></h2>
    <a href="/#contact" class="btn-lux mt-10 inline-flex">Book a strategy call</a>
  </section>
</PageLayout>

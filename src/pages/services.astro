---
import PageLayout from '../layouts/PageLayout.astro';
import { serviceGroups, serviceShort } from '../data/services';
import { serviceDetails } from '../data/serviceDetails';
---
<PageLayout
  title="Services | Luminary Marketing"
  heading="Services built around your practice"
  eyebrow="Our services"
  lede="We focus on the whole process, from brand awareness and patient acquisition to staff performance, lead management, consultation bookings and conversions."
  description="Eight service areas for medical aesthetics and wellness practices: strategy, sales, content, paid ads, devices, brand, events and reporting."
  image="/images/photos/strategy-sticky-notes.webp"
  imageAlt=""
  position="50% 45%"
>
  <section class="container-lux py-20 md:py-28" aria-labelledby="svc-grid">
    <div class="mb-12 max-w-3xl" data-reveal>
      <p class="eyebrow">Choose an area</p>
      <h2 id="svc-grid" class="h-display mt-6 text-4xl md:text-5xl">More than marketing. <span class="text-gold-shine font-medium">We understand the business behind it.</span></h2>
    </div>
    <ul class="grid grid-cols-2 gap-4 lg:grid-cols-4 lg:gap-5">
      {serviceGroups.map((o, k) => (
        <li data-reveal style={`--d:${(k % 4) * 0.08}s`}>
          <a href={o.href} class="group relative block aspect-[4/5] overflow-hidden rounded-[14px] bg-obsidian text-ivory">
            <img src={o.image} alt="" loading="lazy" style={`object-position:${o.pos}`} class="absolute inset-0 h-full w-full object-cover transition-transform duration-[1100ms] ease-out group-hover:scale-[1.08]" />
            <div class="absolute inset-0 bg-gradient-to-t from-obsidian/95 via-obsidian/40 to-obsidian/10"></div>
            <span aria-hidden="true" class="pointer-events-none absolute inset-3 rounded-[10px] border border-ivory/0 transition-colors duration-500 group-hover:border-champagne/70"></span>
            <div class="absolute inset-x-0 bottom-0 p-5 md:p-6">
              <span class="font-display text-xs tracking-[0.3em] text-champagne">{o.n}</span>
              <h3 class="mt-2 font-display text-lg font-light leading-snug md:text-[1.25rem]">{serviceShort[k]}</h3>
              <span class="mt-3 inline-flex items-center gap-2 text-[0.62rem] font-medium uppercase tracking-[0.22em] text-champagne-soft opacity-0 transition-opacity duration-500 group-hover:opacity-100">View details
                <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              </span>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </section>

  {serviceGroups.map((g, k) => {
    const v = k % 4;
    const d = serviceDetails[g.slug];
    return (
      <>
        {v === 0 && (
          <section id={g.slug} class="relative isolate scroll-mt-20 overflow-hidden" aria-labelledby={`${g.slug}-t`}>
            <div class="fx-bg absolute inset-0 -z-20" style={`background-image:url('${d.p2[0]}');background-position:${d.p2[1]}`} aria-hidden="true"></div>
            <div class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,rgb(10_10_11/.93),rgb(10_10_11/.8)_50%,rgb(10_10_11/.94))]" aria-hidden="true"></div>
            <div class="container-lux py-24 md:py-32">
              <div class="max-w-2xl" data-reveal>
                <p class="font-display text-sm tracking-[0.3em] text-champagne">{g.n}</p>
                <h2 id={`${g.slug}-t`} class="h-display mt-4 text-4xl md:text-5xl">{g.title}</h2>
                <p class="mt-5 text-[1rem] leading-8 text-ivory/70">{g.text}</p>
                <a href={g.href} class="link-lux mt-7 inline-block">View details</a>
              </div>
              <ul class="mt-14 grid grid-cols-1 gap-4 md:grid-cols-2">
                {g.items.map(([name, text]) => (
                  <li class="glass-card rounded-[14px] border border-ivory/12 bg-obsidian/55 p-7 backdrop-blur-md" data-reveal>
                    <h3 class="font-display text-lg font-normal text-ivory">{name}</h3>
                    <p class="mt-2 text-[0.92rem] leading-7 text-ivory/65">{text}</p>
                  </li>
                ))}
              </ul>
            </div>
          </section>
        )}

        {v === 1 && (
          <section id={g.slug} class="container-lux scroll-mt-20 py-24 md:py-32" aria-labelledby={`${g.slug}-t`}>
            <div class="grid grid-cols-1 gap-12 lg:grid-cols-12 lg:gap-16">
              <div class="lg:col-span-5">
                <div class="lg:sticky lg:top-28" data-reveal="left">
                  <div class="img-round aspect-[4/5] overflow-hidden">
                    <img src={d.p1[0]} alt="" loading="lazy" style={`object-position:${d.p1[1]}`} class="img-zoom h-full w-full object-cover" />
                  </div>
                  <p class="mt-8 font-display text-sm tracking-[0.3em] text-champagne">{g.n}</p>
                  <h2 id={`${g.slug}-t`} class="h-display mt-3 text-3xl md:text-4xl">{g.title}</h2>
                  <p class="mt-4 text-[0.95rem] leading-7 text-ivory/65">{g.text}</p>
                  <a href={g.href} class="link-lux mt-6 inline-block">View details</a>
                </div>
              </div>
              <ul class="divide-y divide-ivory/10 border-y border-ivory/10 self-start lg:col-span-7" data-reveal="right">
                {g.items.map(([name, text]) => (
                  <li class="row-hover grid gap-2 py-6 md:grid-cols-[14rem_1fr] md:gap-8">
                    <h3 class="font-display text-lg font-normal text-ivory">{name}</h3>
                    <p class="text-[0.92rem] leading-7 text-ivory/65">{text}</p>
                  </li>
                ))}
              </ul>
            </div>
          </section>
        )}

        {v === 2 && (
          <section id={g.slug} class="section-light scroll-mt-20" aria-labelledby={`${g.slug}-t`}>
            <div class="container-lux py-24 md:py-32">
              <div class="grid grid-cols-1 items-end gap-10 lg:grid-cols-12" data-reveal>
                <div class="lg:col-span-7">
                  <p class="font-display text-sm tracking-[0.3em] text-gold-deep">{g.n}</p>
                  <h2 id={`${g.slug}-t`} class="h-display mt-4 text-4xl text-ink md:text-5xl">{g.title}</h2>
                  <p class="mt-5 max-w-xl text-[1rem] leading-8 text-ink/65">{g.text}</p>
                  <a href={g.href} class="link-lux mt-7 inline-block">View details</a>
                </div>
                <div class="img-round hidden aspect-[16/10] overflow-hidden lg:col-span-5 lg:block">
                  <img src={d.p1[0]} alt="" loading="lazy" style={`object-position:${d.p1[1]}`} class="img-zoom h-full w-full object-cover" />
                </div>
              </div>
              <ul class="mt-14 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
                {g.items.map(([name, text]) => (
                  <li class="lite-card rounded-[14px] border border-ink/10 bg-white/60 p-7" data-reveal>
                    <span class="block h-px w-10 bg-gold-deep"></span>
                    <h3 class="mt-5 font-display text-[1.15rem] font-normal text-ink">{name}</h3>
                    <p class="mt-2 text-[0.9rem] leading-7 text-ink/65">{text}</p>
                  </li>
                ))}
              </ul>
            </div>
          </section>
        )}

        {v === 3 && (
          <section id={g.slug} class="relative scroll-mt-20 overflow-hidden bg-graphite/40" aria-labelledby={`${g.slug}-t`}>
            <span aria-hidden="true" class="pointer-events-none absolute -right-4 -top-10 select-none font-display text-[16rem] font-light leading-none text-champagne/[.05] md:text-[24rem]">{g.n}</span>
            <div class="container-lux relative py-24 md:py-32">
              <div class="max-w-3xl" data-reveal>
                <p class="eyebrow">Service {g.n}</p>
                <h2 id={`${g.slug}-t`} class="h-display mt-6 text-4xl md:text-6xl">{g.title}</h2>
                <p class="mt-6 max-w-2xl text-[1rem] leading-8 text-ivory/70">{g.text}</p>
                <a href={g.href} class="link-lux mt-7 inline-block">View details</a>
              </div>
              <ul class="mt-14 grid grid-cols-1 gap-px overflow-hidden rounded-[14px] bg-ivory/10 sm:grid-cols-2 lg:grid-cols-3">
                {g.items.map(([name, text], i) => (
                  <li class="inc relative bg-obsidian p-8" data-reveal style={`--d:${(i % 3) * 0.08}s`}>
                    <h3 class="font-display text-lg font-normal text-ivory">{name}</h3>
                    <p class="mt-3 text-[0.9rem] leading-7 text-ivory/60">{text}</p>
                  </li>
                ))}
              </ul>
            </div>
          </section>
        )}
      </>
    );
  })}

  <section class="container-lux py-24 text-center">
    <h2 class="h-display mx-auto max-w-3xl text-3xl md:text-5xl">Ready to turn attention into <span class="text-gold-shine font-medium">booked consultations?</span></h2>
    <a href="/contact" class="btn-lux mt-10 inline-flex">Book a strategy call</a>
  </section>
</PageLayout>

<style>
  .fx-bg { background-size: cover; background-repeat: no-repeat; }
  @media (min-width: 1024px) and (hover: hover) { .fx-bg { background-attachment: fixed; } }
  .glass-card { transition: transform .6s cubic-bezier(.2,.7,.2,1), border-color .4s, background-color .4s; }
  .glass-card:hover { transform: translateY(-5px); border-color: rgb(217 185 122 / .5); background: rgb(10 10 11 / .7); }
  .lite-card { transition: transform .6s cubic-bezier(.2,.7,.2,1), box-shadow .6s, border-color .4s; }
  .lite-card:hover { transform: translateY(-6px); border-color: rgb(154 120 56 / .5); box-shadow: 0 30px 50px -30px rgba(22,19,14,.4); }
  .inc { transition: background-color .5s; }
  .inc:hover { background: linear-gradient(180deg, rgb(217 185 122 / .09), var(--color-obsidian) 75%); }
  @media (prefers-reduced-motion: reduce) { .glass-card:hover, .lite-card:hover { transform: none; } }
</style>

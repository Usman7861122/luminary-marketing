---
import PageLayout from '../../layouts/PageLayout.astro';
import { serviceGroups, serviceShort } from '../../data/services';
import { serviceDetails } from '../../data/serviceDetails';

export function getStaticPaths() {
  return serviceGroups.map((g, i) => ({ params: { slug: g.slug }, props: { i } }));
}
const { slug } = Astro.params;
const { i } = Astro.props;
const g = serviceGroups[i];
const d = serviceDetails[slug as string];
const others = serviceGroups.map((x, k) => ({ ...x, short: serviceShort[k] })).filter((x) => x.slug !== slug);
---
<PageLayout
  title={`${g.title} | Luminary Marketing`}
  heading={g.title}
  eyebrow={`Services ${g.n}`}
  lede={d.lede}
  description={`${d.lede} ${g.text}`}
  image={d.hero}
  imageAlt=""
  position={d.hpos}
>
  <!-- Overview -->
  <section class="container-lux py-24 md:py-36" aria-labelledby="ov-title">
    <div class="grid grid-cols-1 items-center gap-14 lg:grid-cols-12 lg:gap-20">
      <div class="lg:col-span-6" data-reveal="left">
        <p class="eyebrow">Overview</p>
        <h2 id="ov-title" class="h-display mt-6 text-4xl md:text-5xl">What this means <span class="text-gold-shine font-medium">for your practice.</span></h2>
        <div class="mt-8 max-w-xl space-y-5 text-[1.02rem] leading-8 text-ivory/70">
          {d.intro.map((t) => <p>{t}</p>)}
        </div>
        <div class="mt-10 flex flex-wrap items-center gap-6">
          <a href="/#contact" class="btn-lux inline-flex">Book a strategy call</a>
          <a href="/services" class="link-lux">All services</a>
        </div>
      </div>
      <div class="lg:col-span-6" data-reveal="right" style="--d:.12s">
        <div class="img-round img-zoom aspect-[4/5]">
          <img src={d.p1[0]} alt="" width="1200" height="1500" loading="lazy" style={`object-position:${d.p1[1]}`} />
        </div>
      </div>
    </div>
  </section>

  <!-- What is included -->
  <section class="border-y border-ivory/10 bg-graphite/40" aria-labelledby="inc-title">
    <div class="container-lux py-24 md:py-32">
      <div class="mb-14 grid grid-cols-1 gap-6 md:grid-cols-[1fr_24rem] md:items-end" data-reveal>
        <div>
          <p class="eyebrow">What is included</p>
          <h2 id="inc-title" class="h-display mt-6 text-4xl md:text-5xl">{g.items.length} ways we <span class="text-gold-shine font-medium">help.</span></h2>
        </div>
        <p class="lead">{g.text}</p>
      </div>
      <ul class="grid grid-cols-1 gap-px overflow-hidden rounded-[14px] border border-ivory/10 bg-ivory/10 sm:grid-cols-2 lg:grid-cols-3">
        {g.items.map(([name, text], k) => (
          <li class="inc group relative bg-obsidian p-8 md:p-9" data-reveal style={`--d:${(k % 3) * 0.08}s`}>
            <span class="font-display text-xs tracking-[0.3em] text-champagne/80">{String(k + 1).padStart(2, '0')}</span>
            <h3 class="mt-4 font-display text-[1.3rem] font-normal leading-snug text-ivory transition-colors duration-300 group-hover:text-champagne-soft">{name}</h3>
            <p class="mt-3 text-[0.92rem] leading-7 text-ivory/60">{text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Right for you -->
  <section class="fx-section relative isolate overflow-hidden" aria-labelledby="fit-title">
    <div class="fx-bg absolute inset-0 -z-20" style={`background-image:url('${d.p2[0]}');background-position:${d.p2[1]}`} aria-hidden="true"></div>
    <div class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,rgb(10_10_11/.9),rgb(10_10_11/.78)_50%,rgb(10_10_11/.92))]" aria-hidden="true"></div>
    <div class="container-lux py-28 md:py-40">
      <div data-reveal class="max-w-2xl">
        <p class="eyebrow">Is it right for you</p>
        <h2 id="fit-title" class="h-display mt-6 text-4xl md:text-5xl">Built for practices <span class="text-gold-shine font-medium">like yours.</span></h2>
      </div>
      <div class="mt-14 grid grid-cols-1 gap-6 md:grid-cols-2">
        {[['Best for', d.bestFor], ['Common signs', d.signs]].map(([label, list]) => (
          <div class="rounded-[14px] border border-ivory/12 bg-obsidian/55 p-8 backdrop-blur-md md:p-10" data-reveal>
            <h3 class="text-[0.7rem] font-medium uppercase tracking-[0.26em] text-champagne">{label}</h3>
            <ul class="mt-6 space-y-4">
              {(list as string[]).map((t) => (
                <li class="flex gap-4 text-[0.98rem] leading-7 text-ivory/85">
                  <svg class="mt-[0.45rem] h-3.5 w-3.5 shrink-0 text-champagne" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>
                  <span>{t}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Benefits -->
  <section class="section-light" aria-labelledby="ben-title">
    <div class="container-lux py-24 md:py-32">
      <div class="mb-14 max-w-2xl" data-reveal>
        <p class="eyebrow">Benefits</p>
        <h2 id="ben-title" class="h-display mt-6 text-4xl md:text-5xl">What you <span class="text-gold-shine font-medium">gain.</span></h2>
      </div>
      <ul class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4 lg:gap-5">
        {d.benefits.map(([t, x], k) => (
          <li class="ben rounded-[14px] border border-ink/10 bg-ivory p-8" data-reveal style={`--d:${k * 0.08}s`}>
            <span class="block h-px w-10 bg-gold-deep"></span>
            <h3 class="mt-6 font-display text-[1.3rem] font-normal leading-snug text-ink">{t}</h3>
            <p class="mt-3 text-[0.92rem] leading-7 text-ink/65">{x}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- How it works -->
  <section class="container-lux py-24 md:py-36" aria-labelledby="how-title">
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-12 lg:gap-20">
      <div class="lg:col-span-4" data-reveal>
        <p class="eyebrow">How it works</p>
        <h2 id="how-title" class="h-display mt-6 text-4xl md:text-5xl">A clear process, <span class="text-gold-shine font-medium">start to finish.</span></h2>
      </div>
      <ol class="relative space-y-0 lg:col-span-8">
        {d.steps.map(([t, x], k) => (
          <li class="step relative grid grid-cols-[3.5rem_1fr] gap-6 pb-12 last:pb-0 md:grid-cols-[4.5rem_1fr]" data-reveal style={`--d:${k * 0.08}s`}>
            <span class="relative z-10 grid h-12 w-12 place-items-center rounded-full border border-champagne/60 bg-obsidian font-display text-sm text-champagne md:h-14 md:w-14">{k + 1}</span>
            <div class="pt-2">
              <h3 class="font-display text-2xl font-normal text-ivory">{t}</h3>
              <p class="mt-2 max-w-xl text-[0.98rem] leading-7 text-ivory/65">{x}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- FAQ -->
  <section class="border-t border-ivory/10 bg-graphite/40" aria-labelledby="faq-title">
    <div class="container-lux py-24 md:py-32">
      <div class="grid grid-cols-1 gap-12 lg:grid-cols-12 lg:gap-20">
        <div class="lg:col-span-4" data-reveal>
          <p class="eyebrow">Questions</p>
          <h2 id="faq-title" class="h-display mt-6 text-4xl md:text-5xl">Good to <span class="text-gold-shine font-medium">know.</span></h2>
          <div class="mt-10 rounded-[14px] border border-ivory/10 p-7">
            <p class="font-display text-xl font-light leading-snug text-ivory">Not sure where to start?</p>
            <p class="mt-2 text-[0.9rem] leading-6 text-ivory/60">Tell us about your practice and we will point you to the right next step.</p>
            <a href="/#contact" class="btn-lux btn-lux--sm mt-6 inline-flex">Book a strategy call</a>
          </div>
        </div>
        <div class="min-w-0 lg:col-span-8" data-reveal="right">
          {d.faqs.map(([q, a]) => (
            <details class="faq group border-b border-ivory/10 py-6 first:border-t">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-6 font-display text-xl font-normal text-ivory transition-colors hover:text-champagne-soft">
                {q}
                <svg class="h-4 w-4 shrink-0 text-champagne transition-transform duration-300 group-open:rotate-45" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
              </summary>
              <p class="mt-4 max-w-2xl text-[0.98rem] leading-7 text-ivory/65">{a}</p>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Other services -->
  <section class="container-lux py-24 md:py-32" aria-labelledby="oth-title">
    <div class="mb-12 flex items-end justify-between gap-6" data-reveal>
      <h2 id="oth-title" class="h-display text-3xl md:text-5xl">Other <span class="text-gold-shine font-medium">services.</span></h2>
      <a href="/services" class="link-lux hidden sm:inline-block">View all services</a>
    </div>
    <ul class="grid grid-cols-2 gap-4 lg:grid-cols-4 lg:gap-5">
      {others.map((o) => (
        <li data-reveal>
          <a href={o.href} class="oth group relative block aspect-[4/5] overflow-hidden rounded-[14px] bg-obsidian text-ivory">
            <img src={o.image} alt="" loading="lazy" style={`object-position:${o.pos}`} class="absolute inset-0 h-full w-full object-cover transition-transform duration-[1100ms] ease-out group-hover:scale-[1.08]" />
            <div class="absolute inset-0 bg-gradient-to-t from-obsidian/95 via-obsidian/40 to-obsidian/10"></div>
            <span aria-hidden="true" class="pointer-events-none absolute inset-3 rounded-[10px] border border-ivory/0 transition-colors duration-500 group-hover:border-champagne/70"></span>
            <div class="absolute inset-x-0 bottom-0 p-5 md:p-6">
              <span class="font-display text-xs tracking-[0.3em] text-champagne">{o.n}</span>
              <h3 class="mt-2 font-display text-lg font-light leading-snug md:text-[1.25rem]">{o.short}</h3>
            </div>
          </a>
        </li>
      ))}
      <li data-reveal>
        <a href="/services" class="group flex aspect-[4/5] flex-col justify-between rounded-[14px] border border-champagne/30 bg-ivory/[.03] p-6 transition-colors duration-500 hover:border-champagne hover:bg-champagne/[.07] md:p-7">
          <span class="font-display text-xs tracking-[0.3em] text-champagne">All</span>
          <span>
            <span class="block font-display text-xl font-light leading-snug text-ivory md:text-2xl">See every service in detail</span>
            <span class="mt-5 inline-flex items-center gap-2 text-[0.66rem] font-medium uppercase tracking-[0.22em] text-champagne-soft">View all services
              <svg class="h-3.5 w-3.5 transition-transform duration-500 group-hover:translate-x-1.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </span>
          </span>
        </a>
      </li>
    </ul>
  </section>

  <section class="container-lux pb-28 text-center md:pb-36">
    <h2 class="h-display mx-auto max-w-3xl text-4xl md:text-5xl" data-reveal>Ready to turn attention into <span class="text-gold-shine font-medium">booked consultations?</span></h2>
    <a href="/#contact" class="btn-lux mt-10 inline-flex">Book a strategy call</a>
  </section>
</PageLayout>

<style>
  .fx-bg { background-size: cover; background-repeat: no-repeat; }
  @media (min-width: 1024px) and (hover: hover) { .fx-bg { background-attachment: fixed; } }
  .inc { transition: background-color .5s; }
  .inc:hover { background: linear-gradient(180deg, rgb(217 185 122 / .09), var(--color-obsidian) 75%); }
  .ben { transition: transform .6s cubic-bezier(.2,.7,.2,1), box-shadow .6s, border-color .4s; }
  .ben:hover { transform: translateY(-6px); border-color: rgb(154 120 56 / .5); box-shadow: 0 30px 50px -30px rgba(22,19,14,.45); }
  .step:not(:last-child)::before { content: ""; position: absolute; left: 1.5rem; top: 3rem; bottom: 0; width: 1px; background: linear-gradient(180deg, rgb(217 185 122 / .5), rgb(244 239 230 / .08)); }
  @media (min-width: 768px) { .step:not(:last-child)::before { left: 1.75rem; top: 3.5rem; } }
  .faq summary::-webkit-details-marker { display: none; }
  @media (prefers-reduced-motion: reduce) { .ben:hover { transform: none; } }
</style>

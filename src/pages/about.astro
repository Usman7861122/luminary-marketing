---
import PageLayout from '../layouts/PageLayout.astro';

const credentials = [
  { title: '19 years', label: 'In medical aesthetics' },
  { title: 'Plastic surgery', label: 'Hands-on practice experience' },
  { title: 'Medical device sales', label: 'Positioning aesthetic technology' },
  { title: 'Sales and marketing leadership', label: 'Director level' },
];
const matters = [
  { title: 'From lead to paying patient', text: 'Brittany knows the whole business, from generating leads to converting those leads into paying patients.' },
  { title: 'What happens after the inquiry', text: 'Front desk performance, phone inquiries, patient coordinators, consultation bookings and follow-up all decide whether marketing pays off. She has led teams through every one of them.' },
  { title: 'Marketing with sales leadership', text: 'Luminary combines creative marketing with real-world sales leadership and medical industry experience, so strategy and conversion work as one.' },
];
const clients = [
  { title: 'Plastic surgeons', text: 'Consultation-focused marketing and sales support for surgical practices.', image: '/images/photos/consult-room.webp', pos: '50% 50%' },
  { title: 'Med spas', text: 'Content, ads and follow-up that keep treatment rooms and calendars full.', image: '/images/photos/ring-light-beauty.webp', pos: '50% 50%' },
  { title: 'Wellness businesses', text: 'A calm, premium brand and a clear path from inquiry to booking.', image: '/images/photos/spa-candles.webp', pos: '50% 50%' },
  { title: 'Established medical practices', text: 'Executive-level strategy and team training for practices ready to scale.', image: '/images/photos/team-sticky-clinic.webp', pos: '50% 40%' },
];
---
<PageLayout
  title="About | Luminary Marketing"
  heading="Meet Brittany Garabedian."
  eyebrow="About Luminary"
  lede="19 years inside plastic surgery and medical aesthetics, now helping practices turn attention into booked patients."
  description="Brittany Garabedian brings 19 years of medical aesthetics, medical device sales and practice leadership to Luminary Marketing Agency."
  image="/images/about-hero.webp"
  imageAlt="Brittany Garabedian standing at the reception desk of a modern aesthetic practice"
  position="60% 30%"
>
  <section class="container-lux py-24 md:py-36" aria-labelledby="story-title">
    <div class="grid items-center gap-14 lg:grid-cols-12 lg:gap-20">
      <div class="lg:col-span-6" data-reveal="left">
        <p class="eyebrow">Her story</p>
        <h2 id="story-title" class="h-display mt-6 text-4xl md:text-5xl">More than marketing. <span class="text-gold-shine font-medium">We understand the business behind it.</span></h2>
        <div class="mt-8 max-w-xl space-y-5 text-[1.02rem] leading-8 text-ivory/70">
          <p>Brittany's career spans plastic surgery, medical aesthetics, medical device sales, practice management and sales conversion, including leadership as a Director of Sales and Marketing.</p>
          <p>She has managed sales, marketing, teams and the daily operations of a practice. That experience is why Luminary looks past the lead and at everything that happens after it.</p>
          <p>Luminary is a full-service marketing, sales and practice growth partner for practices that want more than posts and followers.</p>
        </div>
        <div class="mt-10 flex flex-wrap items-center gap-6">
          <a href="/contact" class="btn-lux inline-flex">Book a strategy call</a>
          <a href="/services" class="link-lux">Our services</a>
        </div>
      </div>
      <div class="lg:col-span-6" data-reveal="right" style="--d:.12s">
        <div class="img-round img-zoom aspect-[4/5]">
          <img src="/images/brittney-studio.webp" alt="Brittany at work with her laptop, camera and marketing strategy books" width="896" height="1119" loading="lazy" class="object-[50%_35%]" />
        </div>
      </div>
    </div>
  </section>

  <section class="border-y border-ivory/10 bg-graphite/40" aria-label="Experience at a glance">
    <ul class="container-lux grid divide-y divide-ivory/10 sm:grid-cols-2 sm:divide-y-0 lg:grid-cols-4 lg:divide-x">
      {credentials.map((c) => (
        <li class="cred relative flex flex-col px-2 py-10 sm:px-8 lg:px-7 lg:py-14" data-reveal>
          <h3 class="cred-t font-display text-[1.45rem] font-light leading-[1.15] text-gold-shine lg:min-h-[3.4rem]">{c.title}</h3>
          <p class="mt-4 text-[0.7rem] uppercase tracking-[0.22em] text-ivory/60">{c.label}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="fx-section relative isolate overflow-hidden" aria-labelledby="matters-title">
    <div class="fx-bg absolute inset-0 -z-20" style="background-image:url('/images/stock/portrait-calm.webp')" aria-hidden="true"></div>
    <div class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,rgb(10_10_11/.84),rgb(10_10_11/.68)_50%,rgb(10_10_11/.86))]" aria-hidden="true"></div>
    <div class="container-lux py-28 md:py-44">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-20">
      <div class="lg:col-span-4" data-reveal>
        <p class="eyebrow">Why it matters to you</p>
        <h2 id="matters-title" class="h-display mt-6 text-4xl md:text-5xl">Real experience, <span class="text-gold-shine font-medium">on your side.</span></h2>
      </div>
      <ul class="divide-y divide-ivory/10 border-y border-ivory/10 lg:col-span-8" data-stagger>
        {matters.map((m) => (
          <li class="row-hover grid gap-2 py-8 md:grid-cols-[16rem_1fr] md:gap-10">
            <h3 class="font-display text-xl font-normal text-ivory">{m.title}</h3>
            <p class="text-[0.95rem] leading-7 text-ivory/65">{m.text}</p>
          </li>
        ))}
      </ul>
    </div>
    </div>
  </section>

  <section class="section-light" aria-labelledby="who-title">
    <div class="container-lux py-24 md:py-32">
      <div class="grid items-end gap-10 md:grid-cols-[1fr_24rem]" data-reveal>
        <div>
          <p class="eyebrow">Who we work with</p>
          <h2 id="who-title" class="h-display mt-6 text-4xl md:text-5xl">Built for practices <span class="text-gold-shine font-medium">ready to grow.</span></h2>
        </div>
        <p class="lead">We work closely with practice owners, physicians, leadership and staff, and with business owners who want a more complete approach to marketing and growth.</p>
      </div>
      <ul class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4 lg:gap-5">
        {clients.map((c, i) => (
          <li data-reveal style={`--d:${i * 0.08}s`}>
            <a href="/services" class="who group relative block aspect-[4/5] overflow-hidden rounded-[14px] bg-obsidian text-ivory shadow-[0_30px_60px_-35px_rgba(22,19,14,.7)]">
              <img src={c.image} alt="" loading="lazy" style={`object-position:${c.pos}`} class="absolute inset-0 h-full w-full object-cover transition-transform duration-[1200ms] ease-out group-hover:scale-[1.08]" />
              <div class="absolute inset-0 bg-gradient-to-t from-obsidian/95 via-obsidian/45 to-obsidian/10 transition-opacity duration-500 group-hover:from-obsidian/90"></div>
              <span aria-hidden="true" class="who-ring pointer-events-none absolute inset-3 rounded-[10px] border border-ivory/0 transition-colors duration-500 group-hover:border-champagne/70"></span>
              <div aria-hidden="true" class="absolute inset-x-0 top-0 h-24 bg-gradient-to-b from-obsidian/55 to-transparent"></div>
              <span aria-hidden="true" class="absolute left-6 top-6 font-display text-xs tracking-[0.3em] text-champagne">0{i + 1}</span>
              <div class="absolute inset-x-0 bottom-0 p-6">
                <h3 class="font-display text-[1.45rem] font-light leading-tight">{c.title}</h3>
                <p class="who-text overflow-hidden text-[0.88rem] leading-6 text-ivory/80">{c.text}</p>
                <span class="mt-4 inline-flex items-center gap-2 text-[0.66rem] font-medium uppercase tracking-[0.22em] text-champagne-soft">How we help
                  <svg class="h-3.5 w-3.5 transition-transform duration-500 group-hover:translate-x-1.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                </span>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="container-lux py-24 text-center md:py-32">
    <h2 class="h-display mx-auto max-w-3xl text-4xl md:text-5xl" data-reveal>Let's talk about turning attention into <span class="text-gold-shine font-medium">patients.</span></h2>
    <div class="mt-10 flex flex-wrap items-center justify-center gap-6">
      <a href="/contact" class="btn-lux inline-flex">Book a strategy call</a>
      <a href="/difference" class="link-lux">The Luminary Difference</a>
    </div>
  </section>
</PageLayout>

<style>
  .who { transition: transform .6s cubic-bezier(.2,.7,.2,1), box-shadow .6s; }
  .who:hover, .who:focus-visible { transform: translateY(-8px); box-shadow: 0 45px 70px -35px rgba(22,19,14,.85), 0 0 0 1px rgb(217 185 122 / .35); }
  @media (hover: hover) and (min-width: 768px) {
    .who-text { max-height: 0; opacity: 0; padding-top: 0; transition: max-height .5s ease-out, opacity .5s ease-out, padding-top .5s ease-out; }
    .who:hover .who-text, .who:focus-visible .who-text { max-height: 8rem; opacity: 1; padding-top: .75rem; }
  }
  @media (prefers-reduced-motion: reduce) { .who:hover { transform: none; } }

  .fx-bg { background-size: cover; background-position: center; background-repeat: no-repeat; }
  @media (min-width: 1024px) and (hover: hover) { .fx-bg { background-attachment: fixed; } }

  .cred { transition: background-color .5s; }
  .cred::before { content: ""; position: absolute; left: 0; right: 0; top: -1px; height: 1px; background: var(--color-champagne); transform: scaleX(0); transform-origin: left; transition: transform .6s cubic-bezier(.2,.7,.2,1); }
  .cred:hover, .cred:focus-within { background: linear-gradient(180deg, rgb(217 185 122 / .08), transparent 80%); }
  .cred:hover::before, .cred:focus-within::before { transform: scaleX(1); }
  .cred-t { transition: filter .4s; }
  .cred:hover .cred-t { filter: brightness(1.18); }
</style>

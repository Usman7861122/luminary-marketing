---
import { site, instagramTiles } from '../../data/site';
---
<section class="relative overflow-hidden" aria-labelledby="ig-title">
  <svg aria-hidden="true" class="pointer-events-none absolute -right-16 -top-16 h-[22rem] w-[22rem] text-champagne opacity-[.13] md:-right-24 md:-top-24 md:h-[34rem] md:w-[34rem] [-webkit-mask-image:radial-gradient(circle_at_30%_70%,#000_10%,transparent_70%)] [mask-image:radial-gradient(circle_at_30%_70%,#000_10%,transparent_70%)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width=".5"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r=".7" fill="currentColor"/></svg>
  <svg aria-hidden="true" class="pointer-events-none absolute -bottom-20 -left-20 h-[20rem] w-[20rem] text-champagne opacity-[.13] md:-bottom-28 md:-left-28 md:h-[30rem] md:w-[30rem] [-webkit-mask-image:radial-gradient(circle_at_70%_30%,#000_10%,transparent_70%)] [mask-image:radial-gradient(circle_at_70%_30%,#000_10%,transparent_70%)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width=".5"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r=".7" fill="currentColor"/></svg>
<div class="container-lux relative py-28 md:py-40">
  <div class="mb-12 flex flex-wrap items-end justify-between gap-6" data-reveal>
    <div>
      <p class="eyebrow">Instagram</p>
      <h2 id="ig-title" class="h-display mt-6 text-4xl [overflow-wrap:anywhere] md:text-6xl">Follow <span class="text-gold-shine block pb-2 text-[clamp(1.35rem,5.6vw,3.75rem)] font-medium leading-[1.2]">@{site.instagram}</span></h2>
    </div>
    <a href={site.instagramUrl} target="_blank" rel="noopener" class="btn-lux btn-lux--sm">Follow on Instagram</a>
  </div>

  <ul class="grid grid-cols-2 gap-3 sm:grid-cols-3 md:gap-4 lg:grid-cols-6">
    {instagramTiles.map((t, i) => (
      <li data-reveal style={`--d:${i * 0.07}s`}>
        <a href={site.instagramUrl} target="_blank" rel="noopener" class="group relative block aspect-[3/4] img-round" aria-label={`Open Instagram: ${t.alt}`}>
          <img src={t.src} alt={t.alt} loading="lazy" class="transition-transform duration-[900ms] ease-out group-hover:scale-[1.07]" />
          <span class="absolute inset-0 grid place-items-center bg-obsidian/55 opacity-0 backdrop-blur-[2px] transition-opacity duration-500 group-hover:opacity-100">
            <svg class="h-7 w-7 text-champagne-soft" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r=".6" fill="currentColor"/></svg>
          </span>
        </a>
      </li>
    ))}
  </ul>
</div>
</section>

---
import LuminaryStack from '../react/LuminaryStack';
---
<section id="system" class="relative overflow-hidden border-y border-ivory/[0.07]" aria-labelledby="system-title">
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_60%_70%_at_74%_52%,rgb(217_185_122/.07),transparent_70%)]"></div>
  <div class="container-lux relative grid items-center gap-10 py-24 md:py-32 lg:grid-cols-[0.9fr_1.1fr] lg:gap-12">
    <div data-reveal="left">
      <p class="eyebrow flex items-center gap-3"><span aria-hidden="true" class="size-2 rounded-full bg-champagne shadow-[0_0_0_4px_rgb(217_185_122/.15)]"></span>The Luminary method</p>
      <h2 id="system-title" class="h-display mt-7 text-4xl md:text-6xl">One system that turns attention into <span class="text-gold-shine font-medium">booked consults.</span></h2>
      <p class="lead mt-7 max-w-[30rem]">Strategy, content, ads and your website work as one connected system, so every post, click and search brings a patient closer to booking.</p>
      <div class="mt-9 flex flex-wrap items-center gap-x-8 gap-y-5">
        <a href="/#contact" class="btn-lux">Book a strategy call
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </a>
        <a href="/#portfolio" class="link-lux">See our work</a>
      </div>
    </div>
    <div>
      <LuminaryStack client:visible />
    </div>
  </div>
</section>

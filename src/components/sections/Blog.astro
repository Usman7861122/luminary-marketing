---
import { posts } from '../../data/site';
---
<section id="journal" class="section-light border-t border-ink/10" aria-labelledby="blog-title">
  <div class="container-lux py-28 md:py-40">
    <div class="mb-14 flex flex-wrap items-end justify-between gap-6" data-reveal>
      <div>
        <p class="eyebrow">Journal</p>
        <h2 id="blog-title" class="h-display mt-6 text-4xl md:text-6xl">Ideas for <span class="text-gold-shine font-medium">growing practices.</span></h2>
      </div>
      <a href="/blog" class="btn-lux btn-lux--sm">All articles</a>
    </div>

    <div class="grid gap-10 md:grid-cols-3">
      {posts.map((p, i) => (
        <article data-reveal style={`--d:${i * 0.12}s`} class="group lift">
          <a href={`/blog#${p.slug}`} class="block">
            <div class="img-round aspect-[4/3]">
              <img src={p.image} alt="" loading="lazy" class="transition-transform duration-[900ms] ease-out group-hover:scale-[1.05]" />
            </div>
            <p class="mt-6 text-[0.68rem] uppercase tracking-[0.22em] text-gold-deep">{p.category}<span class="text-ink/45"> &nbsp;·&nbsp; {p.date} &nbsp;·&nbsp; {p.read}</span></p>
            <h3 class="font-display mt-3 text-2xl font-light leading-snug text-ink transition-colors group-hover:text-gold-deep">{p.title}</h3>
          </a>
        </article>
      ))}
    </div>
  </div>
</section>
